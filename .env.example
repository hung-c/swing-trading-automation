# Copy to .env for local runs. In GitHub Actions these are repository secrets.
# The Vercel web app (web/) only needs DATABASE_URL (+ optional DASHBOARD_PASSWORD).

# Alpaca paper-only account (free). https://app.alpaca.markets -> Paper -> API keys
ALPACA_KEY=
ALPACA_SECRET=

# Finnhub free key. https://finnhub.io/register
FINNHUB_KEY=

# Alpha Vantage free key (25 req/day). https://www.alphavantage.co/support/#api-key
ALPHAVANTAGE_KEY=

# Groq free key. https://console.groq.com/keys
GROQ_KEY=

# Optional Gemini fallback. https://aistudio.google.com/apikey
GEMINI_KEY=

# Neon Postgres — required. Same URL in .env, GitHub Actions secrets, and Vercel.
# Jobs will not fall back to sqlite. https://console.neon.tech
# https://console.neon.tech -> New project -> Connection string (include sslmode=require)
DATABASE_URL=

# Optional password gate for the Vercel dashboard. Set the same value in Vercel env.
DASHBOARD_PASSWORD=

# Optional: Massive (ex-Polygon) free key for fallback daily bars. https://massive.com
MASSIVE_KEY=

# Optional: Telegram push for actionable alerts (the dashboard remains the full record)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# SEC EDGAR requires a descriptive User-Agent: "Name email"
SEC_USER_AGENT=
