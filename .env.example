# Copy to .env for local runs. In GitHub Actions these are repository secrets.

# Alpaca paper-only account (free). https://app.alpaca.markets -> Paper -> API keys
ALPACA_KEY=
ALPACA_SECRET=

# Finnhub free key. https://finnhub.io/register
FINNHUB_KEY=

# Alpha Vantage free key (25 req/day). https://www.alphavantage.co/support/#api-key
ALPHAVANTAGE_KEY=

# Groq free key. https://console.groq.com/keys
GROQ_KEY=

# Optional Gemini fallback. https://aistudio.google.com/apikey
GEMINI_KEY=

# Notion internal integration token + the page the system should build under.
# https://www.notion.so/profile/integrations -> New integration -> copy "Internal Integration Secret"
# Then open the parent page in Notion -> ... -> Connections -> add the integration.
NOTION_TOKEN=
NOTION_PARENT_PAGE_ID=

# Optional: Massive (ex-Polygon) free key for fallback daily bars. https://massive.com
MASSIVE_KEY=

# Optional: Telegram push
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# SEC EDGAR requires a descriptive User-Agent: "Name email"
SEC_USER_AGENT=
